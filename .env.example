# Copy to .env. Never commit a real value.
ANTHROPIC_API_KEY=

# Shopify Admin API (custom app, Admin API access token). Scopes: read_products,
# read_customers, read_orders.
SHOPIFY_STORE_DOMAIN=levelup-peoples.myshopify.com
SHOPIFY_ADMIN_TOKEN=
# Shopify Storefront API access token (public, unauthenticated_read_product_listings,
# unauthenticated_write_checkouts, unauthenticated_read_checkouts). Carts and the hosted
# checkout URL come from here.
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Development principal bound at session start (a Shopify customer GID such as
# gid://shopify/Customer/123, or "guest"). TODO: replace with the storefront's own sign-in.
DEV_CUSTOMER_ID=guest

DEMO_LOG_LEVEL=INFO
